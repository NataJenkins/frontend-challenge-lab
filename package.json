{
    "name": "frontend-challenge-lab",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "npm run test:unit:run",
        "test:unit": "vitest --project=unit",
        "test:unit:run": "vitest --project=unit --run",
        "test:storybook": "vitest --project=storybook",
        "test:storybook:run": "vitest --project=storybook --run",
        "test:coverage": "vitest --project=unit --coverage --run"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-icons": "^5.7.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.5.5",
        "@storybook/addon-docs": "^10.5.5",
        "@storybook/addon-vitest": "^10.5.5",
        "@storybook/react-vite": "^10.5.5",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/jest-axe": "^3.5.9",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-storybook": "^10.5.5",
        "globals": "^17.7.0",
        "jest-axe": "^11.0.0",
        "jsdom": "^29.1.1",
        "playwright": "^1.62.0",
        "sass": "^1.102.0",
        "storybook": "^10.5.5",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.1",
        "vitest": "^4.1.10"
    }
}
